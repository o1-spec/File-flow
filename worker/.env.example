# S3 / Object Storage Configuration (MinIO or Cloudflare R2 / AWS S3)
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET=filepipeline

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:password@localhost:5433/filepipeline

# Redis Connection URL (for BullMQ queue processing)
REDIS_URL=redis://localhost:6379

# Authorization & Admin Settings
JWT_SECRET=your_jwt_secret_key_here
ADMIN_EMAILS=admin@example.com
